# {{cookiecutter.project_name}}: local development configuration.
# Copy to .env (git-ignored). `graph-agents-cli deploy --env <env>` and
# `graph-agents-cli secrets apply --env <env>` read .env.<env>, else .env, and
# export ONLY the keys listed under `secrets.keys` in
# graph-agents-cli-manifest.yaml into the environment's Kubernetes Secret.
# Everything else below is non-secret configuration that the Helm chart sets
# from deployment/helm/{{cookiecutter.project_name}}/values*.yaml.

# --- Application ------------------------------------------------------------
# dev enables GET /playground; anything else disables it.
APP_ENV=dev
# Port the server listens on (uvicorn under fastapi, the server under langgraph-server).
PORT=8000

# --- Agent model (LangChain init_chat_model) --------------------------------
# openai | anthropic | gemini | openai-compatible  (fake is test-only)
MODEL_PROVIDER={{cookiecutter.model_provider}}
MODEL_NAME={{cookiecutter.model}}
{% if cookiecutter.model_provider == 'openai-compatible' -%}
# Base URL of the OpenAI-compatible endpoint (Ollama, vLLM, TGI, ...).
OPENAI_BASE_URL=http://localhost:11434/v1
{% else -%}
# Only for MODEL_PROVIDER=openai-compatible (Ollama, vLLM, TGI, ...).
# OPENAI_BASE_URL=http://localhost:11434/v1
{% endif -%}
# Provider key (Secret). openai -> OPENAI_API_KEY, anthropic -> ANTHROPIC_API_KEY,
# gemini -> GOOGLE_API_KEY (AI Studio), openai-compatible -> MODEL_API_KEY.
{{cookiecutter.provider_key_var}}=

# --- Judge model (evals; defaults to the agent's provider, model and key) ---
# JUDGE_MODEL_PROVIDER=
# JUDGE_MODEL_NAME={{cookiecutter.default_judge_model}}
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# --- Persistence -------------------------------------------------------------
{% if cookiecutter.runtime == 'fastapi' -%}
# memory | postgres. memory needs no database (state is lost on restart); the
# chart sets postgres and supplies POSTGRES_DSN from the subchart or the Secret.
CHECKPOINTER=memory
# POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent
{% else -%}
# LangGraph Server owns persistence. `graph-agents-cli run` and `playground`
# use `langgraph dev` (in-memory) locally; the chart sets these in the cluster.
# DATABASE_URI=postgresql://agent:agent@localhost:5432/agent
# REDIS_URI=redis://localhost:6379
{% endif -%}

# --- Authentication (app/app_utils/auth.py) ---------------------------------
# shared-bearer | product-session
AUTH_POLICY={{cookiecutter.auth_policy}}
# shared-bearer: clients send `Authorization: Bearer <API_KEY>`. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# `graph-agents-cli secrets apply` generates it when absent from the env file.
API_KEY=
# product-session: comma-separated roles allowed to read other principals' threads.
AUTH_READ_ACROSS_ROLES=

# --- Product API (app/app_utils/product_client.py, product-policy.yaml) -----
{% if cookiecutter.has_product_policy -%}
PRODUCT_API_BASE_URL=http://localhost:9000
# Only when product-policy.yaml sets `auth: bearer`.
# PRODUCT_API_TOKEN=
{% else -%}
# Set when a product-policy.yaml is declared (graph-agents-cli create --product-policy).
# PRODUCT_API_BASE_URL=
# PRODUCT_API_TOKEN=
{% endif -%}
# Path of the policy file; defaults to ./product-policy.yaml.
# PRODUCT_POLICY_PATH=product-policy.yaml

# --- Tracing (off unless TRACING_ENABLED=true) ------------------------------
TRACING_ENABLED=false
# metadata: structure, timing, token counts, tool names, error types, hashed
#           principal id; no prompt/completion text, tool args/results, messages.
# full:     everything, including prompts, completions, tool I/O, error messages.
#           Sending full content to a hosted destination is an egress decision.
TRACE_CAPTURE=metadata
# With LANGSMITH_API_KEY set, traces go to LangSmith; otherwise to OTLP.
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT={{cookiecutter.project_name}}
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# OTLP/HTTP collector, used when TRACING_ENABLED=true and no LangSmith key is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- A2A ---------------------------------------------------------------------
# Public base URL advertised in the agent card (defaults to http://HOST:PORT).
# APP_URL=http://localhost:8000

# --- Client side (not read by the app) ---------------------------------------
# `graph-agents-cli run --url ...` and `eval generate --url ...` send this as the
# bearer key when --header is not given.
# GRAPH_AGENTS_CLI_API_KEY=
