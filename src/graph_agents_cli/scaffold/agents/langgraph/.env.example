# {{cookiecutter.project_name}}: local development configuration.
# Copy to .env (git-ignored). `graph-agents-cli deploy --env <env>` and
# `graph-agents-cli secrets apply --env <env>` read .env.<env> (only dev falls
# back to this .env, so local keys never reach staging or prod) and export ONLY
# the keys listed under `secrets.keys` in graph-agents-cli-manifest.yaml into
# the environment's Kubernetes Secret.
# Everything else below is non-secret configuration that the Helm chart sets
# from deployment/helm/{{cookiecutter.project_name}}/values*.yaml.

# --- Application ------------------------------------------------------------
# Exactly `dev` enables GET /playground, /docs and the dev-only relaxations;
# any other value (prod, staging, DEV, unset) is a deployed environment.
APP_ENV=dev
# Port the server listens on (uvicorn under fastapi, the server under langgraph-server).
PORT=8000

# --- Agent model (LangChain init_chat_model) --------------------------------
# openai | anthropic | gemini | openai-compatible  (fake is test-only)
MODEL_PROVIDER={{cookiecutter.model_provider}}
MODEL_NAME={{cookiecutter.model}}
{% if cookiecutter.model_provider == 'openai-compatible' -%}
# Base URL of the OpenAI-compatible endpoint (Ollama, vLLM, TGI, ...).
OPENAI_BASE_URL=http://localhost:11434/v1
{% else -%}
# Only for MODEL_PROVIDER=openai-compatible (Ollama, vLLM, TGI, ...).
# OPENAI_BASE_URL=http://localhost:11434/v1
{% endif -%}
# Provider key (Secret). openai -> OPENAI_API_KEY, anthropic -> ANTHROPIC_API_KEY,
# gemini -> GOOGLE_API_KEY (AI Studio), openai-compatible -> MODEL_API_KEY.
{{cookiecutter.provider_key_var}}=
# OpenAI-API models only (openai, openai-compatible; set for another provider,
# startup refuses). Reasoning effort: none | minimal | low | medium | high |
# xhigh (unset: the model's default). The API: true = the Responses API
# (/v1/responses), false = Chat Completions; unset lets langchain-openai choose
# (Chat Completions but for the models it knows need the Responses API). A model
# that refuses function tools with a reasoning effort on Chat Completions needs
# MODEL_USE_RESPONSES_API=true (or MODEL_REASONING_EFFORT=none); a server with no
# /v1/responses needs false or unset.
# MODEL_REASONING_EFFORT=
# MODEL_USE_RESPONSES_API=

# Structured answers: only with {{cookiecutter.agent_directory}}/response_schema.json (the JSON
# shape of the final answer; without it the agent answers in text). auto (the
# provider's own structured output where the model has it and its client can send
# the schema, else a final_answer tool the model must call) | provider | tool.
# RESPONSE_FORMAT_STRATEGY=auto

# --- Judge model (evals; defaults to the agent's provider, model and key) ---
# JUDGE_MODEL_PROVIDER=
# JUDGE_MODEL_NAME={{cookiecutter.default_judge_model}}
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# Unset: the agent's, when the judge is an OpenAI-API model too.
# JUDGE_REASONING_EFFORT=
# JUDGE_USE_RESPONSES_API=

# --- Persistence -------------------------------------------------------------
{% if cookiecutter.runtime == 'fastapi' -%}
# memory | postgres. memory needs no database (state is lost on restart); the
# chart sets postgres and supplies POSTGRES_DSN from the subchart or the Secret.
CHECKPOINTER=memory
# POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent
# Connection pool per process (shared by the checkpointer and the app tables).
# Connections are health-checked on checkout, so a database restart heals itself.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
{% else -%}
# LangGraph Server owns persistence. `graph-agents-cli run` and `playground`
# use `langgraph dev` (in-memory) locally; the chart sets these in the cluster.
# DATABASE_URI=postgresql://agent:agent@localhost:5432/agent
# REDIS_URI=redis://localhost:6379
{% endif -%}

# --- Authentication (app/app_utils/auth.py) ---------------------------------
# shared-bearer | jwt | custom
AUTH_POLICY={{cookiecutter.auth_policy}}
# shared-bearer: clients send `Authorization: Bearer <API_KEY>`. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# `graph-agents-cli login --write-env` generates it here; `graph-agents-cli
# secrets apply` generates one per environment when neither the env file nor the
# cluster has one (and writes it to that env file; the live key is never
# replaced without --rotate-api-key).
API_KEY=
{% if cookiecutter.auth_policy == 'jwt' -%}
# jwt: per-user principals from a verified OIDC/JWT bearer token. Outside
# APP_ENV=dev the issuer and the audience are required and any configuration
# problem stops startup (under dev a missing issuer or audience is only a
# warning and a problem answers 503).
# Keys: a JWKS URL (https outside dev unless its host is loopback), or one PEM
# public key or certificate (escaped \n newlines accepted), not both.
# Local runs without an identity provider: `graph-agents-cli auth dev-token --sub
# <user>` fills AUTH_JWT_PUBLIC_KEY, AUTH_JWT_ISSUER and AUTH_JWT_AUDIENCE below
# with a dev key (APP_ENV=dev only) and prints a token. Never deploy that key.
AUTH_JWT_JWKS_URL=
# AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Accepted algorithms (never `none`; HS* only with AUTH_JWT_ALLOW_HS=true and AUTH_JWT_SECRET).
# AUTH_JWT_ALGORITHMS=RS256,ES256
# Shared-secret (HS256/384/512) tokens: opt in, and put a secret of at least 32
# bytes in the Secret (the CLI adds AUTH_JWT_SECRET to the allow-list then).
# AUTH_JWT_ALLOW_HS=false
# AUTH_JWT_SECRET=
# A plain-http JWKS URL outside dev, for a trusted in-cluster issuer only.
# AUTH_JWT_JWKS_ALLOW_HTTP=false
# Claim holding the principal id, and the claim (dotted path allowed, e.g.
# realm_access.roles) holding the roles.
# AUTH_JWT_PRINCIPAL_CLAIM=sub
# AUTH_JWT_ROLES_CLAIM=roles
# AUTH_JWT_LEEWAY_S=60
# AUTH_JWT_JWKS_CACHE_S=300
# Agents calling for a user: a token carrying the RFC 8693 actor claim (`act`) is
# the user's (its `sub`) presented by that agent. Empty turns this off (every
# token is the user's own, as in 0.2).
# AUTH_JWT_ACTOR_CLAIM=act
# The client claim (`azp`; `client_id` when absent; Okta uses `cid`), and the
# clients people sign in with: when set, a token with no `act` from any other
# client is treated as that client presenting the user's token (`client:<azp>`).
# AUTH_JWT_CLIENT_CLAIM=azp
# AUTH_JWT_DIRECT_CLIENTS=
{% else -%}
# jwt (AUTH_POLICY=jwt): AUTH_JWT_JWKS_URL or AUTH_JWT_PUBLIC_KEY, AUTH_JWT_ISSUER,
# AUTH_JWT_AUDIENCE; see the project README.
{% endif -%}
# Comma-separated roles allowed to read other principals' threads (and list,
# never decide, their approvals).
AUTH_READ_ACROSS_ROLES=
# Comma-separated roles allowed to manage assistants, crons and the store under
# langgraph-server (empty = nobody).
AUTH_ADMIN_ROLES=
# Agents that may call this one for a user (the actor ids, comma-separated; * for
# any). Empty refuses every delegated request (403) until the agent is listed.
AUTH_ALLOWED_ACTORS=
# Roles a delegated request keeps (empty: an agent acting for a user holds none of
# the user's roles), and how many agents may stand between the user and this one.
# AUTH_DELEGATED_ROLES=
# AUTH_MAX_DELEGATION_DEPTH=3
# When an agent asks for a user, require_user_mentioned needs the record id in the
# user's own words that agent forwarded (origin), always refuses (refuse), or counts
# the agent's request as the user's words (request, the 0.2 behaviour: an opt-out).
# A2A_DELEGATED_MENTIONS=origin
# Tell the model, in one system note, that an agent wrote the request (off: fence only).
# A2A_CALLER_NOTE=on
# Calling other agents (A2A peers, `graph-agents-cli peer add`): send them the user's
# own words when their card reads them (off: never), at most this many characters
# (also the most read from an agent calling this one), how long a peer's checked
# agent card is reused, and the most of a peer's reply the model reads.
# A2A_FORWARD_ORIGIN=auto
# A2A_ORIGIN_MAX_CHARS=4000
# A2A_CARD_TTL_S=300
# A2A_REPLY_MAX_CHARS=6000
# langgraph-server runtime with LANGGRAPH_SERVER_URL set: the request headers
# passed on to the server's auth handler (the headers your policy reads).
# Empty forwards nothing.
# AUTH_FORWARD_HEADERS=authorization,cookie

# --- Outbound APIs (app/app_utils/api_client.py, api-policy.yaml) ----------
{% if cookiecutter.has_api_policy -%}
{% for api in cookiecutter.apis -%}
# {{ api.name }} (auth: {{ api.auth }})
{{ api.base_url_env }}=http://localhost:9000
{% if api.auth == 'bearer' -%}
{{ api.token_env }}=
{% endif -%}
{% endfor -%}
{% if cookiecutter.apis | selectattr('auth', 'equalto', 'exchange') | list -%}
# Token exchange (RFC 8693) for the auth: exchange APIs: the issuer's token endpoint
# and this agent's client there. Put the client secret in .env (it is in secrets.keys).
# Optional: client authentication (or client_secret_post), the subject token type
# sent, the exchange's deadline, how long an exchanged token is reused (at most
# 300 s), how long a refusal or a failing issuer is left alone, tokens kept per
# process, and a plain-http token URL outside dev (a trusted in-cluster issuer only).
# TOKEN_EXCHANGE_CLIENT_AUTH=client_secret_basic
# TOKEN_EXCHANGE_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
# TOKEN_EXCHANGE_TIMEOUT_MS=2000
# TOKEN_EXCHANGE_MAX_TTL_S=300
# TOKEN_EXCHANGE_FAILURE_TTL_S=10
# TOKEN_EXCHANGE_CACHE_MAX=10000
# TOKEN_EXCHANGE_ALLOW_HTTP=false
# TOKEN_EXCHANGE_CLIENT_SECRET=
TOKEN_EXCHANGE_URL=
TOKEN_EXCHANGE_CLIENT_ID=
{% endif -%}
{% else -%}
# No api-policy.yaml is declared, so every outbound API call is refused. Declare
# the APIs tools may call with `graph-agents-cli api add` (see README.md).
{% endif -%}
# Path of the policy file; defaults to ./api-policy.yaml.
# API_POLICY_PATH=api-policy.yaml
# Human approval: an API's `approval` block in api-policy.yaml holds the calls it
# gates until a person approves them (nothing to set here). Approvals live in the
# app's database ({% if cookiecutter.runtime == 'langgraph-server' %}table agent_approvals in DATABASE_URI{% else %}table approvals under CHECKPOINTER=postgres{% endif %};
# in process memory otherwise) and expire after the policy's timeout_s.
# `role:<name>` approvers need a per-user AUTH_POLICY (jwt or custom): under
# shared-bearer every caller is the one principal `shared`, the requester itself.

# --- Run guardrails and request limits (app/app_utils/limits.py) ------------
# A value that does not parse stops the app at startup. Defaults shown.
# Wall-clock limit of one run, in seconds; the run is cancelled (status timeout).
# RUN_TIMEOUT_S=300
# Per model request: timeout in seconds (0 = the provider SDK default) and retries.
# MODEL_TIMEOUT_S=60
# MODEL_MAX_RETRIES=2
# Graph steps per run: two to answer, plus two per tool call made after the
# previous one returned (50 fits 24 sequential calls). A run that reaches it
# ends with a reply saying so (message.end status step_limit).
# RECURSION_LIMIT=50
# Request body cap in bytes (413 above it) and /chat metadata caps (422 above
# them: at most N keys; keys and string values at most N characters).
# MAX_REQUEST_BYTES=1048576
# MAX_METADATA_KEYS=16
# MAX_METADATA_VALUE_CHARS=256
# Longest user message, in characters, on /chat (422 above it) and A2A (an
# invalid-params error): one cap for every surface that reaches the model.
# MAX_MESSAGE_CHARS=32000
# Seconds without an event before the SSE stream sends a ": keep-alive" comment.
# SSE_HEARTBEAT_S=15
# Delete threads (checkpoints and run records) idle for more than N days,
# checked hourly by every replica (best effort). 0 keeps everything.
# RETENTION_DAYS=0

# --- Logging, metrics and CORS -----------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO
# json | text (default: text under APP_ENV=dev, json otherwise). Records carry
# the request id (X-Request-ID), run id, thread id and hashed principal. Access
# lines keep the path without its query string; outbound API calls are logged
# by API, method, operation id and path template (httpx's own URL lines are
# off); Python warnings become records too. LOG_LEVEL=DEBUG also turns on
# third-party debug logs, which can hold message content: use it locally.
# LOG_FORMAT=json
# GET /metrics serves Prometheus text; unauthenticated like /health and /ready
# unless METRICS_TOKEN is set, so keep it off the public ingress either way.
# METRICS_ENABLED=true
# Optional secret: when set, GET /metrics answers only requests that send
# `Authorization: Bearer <METRICS_TOKEN>` (configure your scraper with it{% if cookiecutter.deployment_target == 'kubernetes' %}:
# the chart's ServiceMonitor sends it with metrics.serviceMonitor.bearerToken.enabled{% endif %});
# /health and /ready stay open for the probes. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# METRICS_TOKEN=
# Optional secret: when set, the hashed principal id in logs, traces and run
# records is HMAC-SHA256(PRINCIPAL_HASH_SALT, id) instead of a plain sha256, so
# nobody holding them can confirm a guessed id (an email address, say) by
# hashing it. Keep it stable: changing it changes every hash, and new ones
# no longer match older logs and run records.
# PRINCIPAL_HASH_SALT=
# Comma-separated browser origins allowed to call the API; empty = no CORS.
# (LangGraph Server reads the same variable: `langgraph dev` allows every
# origin while it is unset; the server image starts with none.)
# CORS_ALLOW_ORIGINS=https://app.example.com

# --- Tracing (off unless TRACING_ENABLED=true) ------------------------------
TRACING_ENABLED=false
# metadata: structure, timing, token counts, tool names, error types, hashed
#           principal id; no prompt/completion text, tool args/results, messages,
#           or the client's /chat metadata.
# full:     everything, including prompts, completions, tool I/O, error messages
#           and the client's /chat metadata (under client_metadata).
#           Sending full content to a hosted destination is an egress decision.
TRACE_CAPTURE=metadata
# With LANGSMITH_API_KEY set, traces go to LangSmith; otherwise to OTLP.
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT={{cookiecutter.project_name}}
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# OTLP/HTTP collector, used when TRACING_ENABLED=true and no LangSmith key is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Correlation across agents (peers, the default): every call of another agent
# (`protocol: a2a`, whatever its auth) or of an `auth: forward` or
# `auth: exchange` API carries this request's X-Request-ID and, under OTLP
# tracing, its W3C trace context (traceparent, tracestate); other APIs never
# receive them. An incoming traceparent continues the caller's trace on the A2A
# routes (/a2a/...) only. all: every API, and every path (behind a tracing
# gateway). off (or false): neither. true reads as peers.
# PROPAGATE_TRACE_HEADERS=peers

# --- A2A ---------------------------------------------------------------------
# Public base URL advertised in the agent card (defaults to http://HOST:PORT).
# APP_URL=http://localhost:8000
# What the agent card (and its chat skill) says the agent does, and the
# version it advertises (AGENT_VERSION is also the OpenAPI and trace version).
# A2A_DESCRIPTION=Answers questions about orders and their delivery status.
# AGENT_VERSION=0.1.0
# A2A tasks live in the app's database ({% if cookiecutter.runtime == 'langgraph-server' %}table agent_a2a_tasks in DATABASE_URI{% else %}table a2a_tasks under CHECKPOINTER=postgres{% endif %}:
# every replica sees them, restarts keep them; in process memory otherwise) and
# are dropped this many seconds after their last update (0: when their thread
# is deleted; in memory, at restart).
# A2A_TASK_TTL_S=3600

# --- Client side (not read by the app) ---------------------------------------
# `graph-agents-cli run --url ...` and `eval generate --url ...` send this as the
# bearer key when --header is not given.
# GRAPH_AGENTS_CLI_API_KEY=
