# LangGraph Server runtime image. Mirrors the shape of `langgraph dockerfile`
# output, with two differences: the dependencies are installed at the exact
# versions of uv.lock (not resolved again), and the server runs as uid/gid 1000.
#
# The base image is pinned to the langgraph-api release in uv.lock
# (langchain/langgraph-api:<version>-py3.12): bump both together. For fully
# reproducible builds pin it by digest as well
# (`...:0.14.4-py3.12@sha256:<digest>`; `docker buildx imagetools inspect
# <image>` prints it). Mirror it for a disconnected registry and change the
# FROM line accordingly.
FROM langchain/langgraph-api:0.14.4-py3.12

# The whole project (minus .dockerignore) is the dependency, so api-policy.yaml,
# the outbound API policy the API client enforces, is in the image when the
# project has one (made readable by uid 1000 below, whatever its mode in the
# working tree: an unreadable policy refuses every call).
ADD . /deps/{{cookiecutter.project_name}}

# `uv export` writes the locked versions (with hashes); they are installed
# without resolving again, and must agree with the base image's constraints, so
# a lock that conflicts with the server fails the build instead of the server.
# The lock must also pin the base image's own langgraph-api release (the build
# stops with the tag to use otherwise). The base image ships uv; nothing is
# added to it.
RUN cd /deps/{{cookiecutter.project_name}} \
 && if [ -f api-policy.yaml ]; then chmod a+r api-policy.yaml; fi \
 && base_api="$(python -c "import importlib.metadata as m; print(m.version('langgraph-api'))")" \
 && uv export --quiet --frozen --no-dev --no-emit-project --no-header -o /tmp/requirements.txt \
 && uv pip install --system --no-cache --compile-bytecode --no-deps \
      -c /api/constraints.txt -r /tmp/requirements.txt \
 && uv pip install --system --no-cache --compile-bytecode --no-deps \
      -e /deps/{{cookiecutter.project_name}} \
 && rm /tmp/requirements.txt \
 && lock_api="$(python -c "import importlib.metadata as m; print(m.version('langgraph-api'))")" \
 && if [ "$base_api" != "$lock_api" ]; then \
      echo "uv.lock pins langgraph-api $lock_api but the base image is $base_api:" \
           "use FROM langchain/langgraph-api:$lock_api-py3.12" >&2; \
      exit 1; \
    fi

# The graph, the custom routes (/chat, /threads, /health, /ready, /metrics,
# /playground, A2A) and the auth handler, as langgraph.json declares them.
# `disable_meta` turns off the server's unauthenticated meta routes (/docs,
# /openapi.json, /info, /metrics); the app's own /metrics takes over.
ENV LANGSERVE_GRAPHS='{"agent": "/deps/{{cookiecutter.project_name}}/{{cookiecutter.agent_directory}}/agent.py:graph"}'
ENV LANGGRAPH_HTTP='{"app": "/deps/{{cookiecutter.project_name}}/{{cookiecutter.agent_directory}}/fast_api_app.py:app", "disable_meta": true}'
ENV LANGGRAPH_AUTH='{"path": "/deps/{{cookiecutter.project_name}}/{{cookiecutter.agent_directory}}/app_utils/auth.py:auth"}'
# LANGGRAPH_SERVER tells fast_api_app.py it is mounted inside the server (no
# checkpointer binding). The server allows every CORS origin when
# CORS_ALLOW_ORIGINS is unset; the image starts from none, like the fastapi
# runtime: list your browser origins in CORS_ALLOW_ORIGINS (comma-separated).
ENV LANGGRAPH_SERVER=1 \
    CORS_ALLOW_ORIGINS="" \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /deps/{{cookiecutter.project_name}}

USER 1000:1000
